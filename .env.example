# 复制为 .env，填写支持 Chat Completions 的模型服务配置。
# BASE_URL 是接口前缀，如 https://你的服务域名/v1，不含 /chat/completions。
LLM_BASE_URL=
LLM_API_KEY=
FAST_MODEL=
# 留空则与快通道共用模型。
SLOW_MODEL=

# 部分模型要求 max_tokens；按服务商文档修改。
LLM_TOKEN_FIELD=max_completion_tokens
# 服务支持 JSON mode 时可打开；无论是否打开，程序都会校验输出结构。
LLM_JSON_MODE=false
FAST_MAX_TOKENS=800
SLOW_MAX_TOKENS=2400
LLM_TIMEOUT_SECONDS=60
HISTORY_TURNS=8
HISTORY_MAX_CHARS=12000
